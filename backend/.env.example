# Local defaults — copy to .env and fill in secrets
# SQLite is used when DATABASE_URL is not set
DATABASE_URL=sqlite:///./annadata.db
SECRET_KEY=change-me-local-secret
MISTRAL_API_KEY=your_mistral_api_key
# ministral-8b-latest works on rate-limited keys; small/medium-latest need higher quota
MISTRAL_MODEL=ministral-8b-latest
MISTRAL_FALLBACK_MODEL=ministral-14b-latest
DATA_GOV_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad38534209a181d0
PORT=8000
